{
  "name": "self-managed-api",
  "version": "0.1.0",
  "private": true,
  "description": "Local API and MCP integration maintenance with reviewed migrations and isolated validation",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "packageManager": "pnpm@11.19.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "bin": {
    "self-managed-api": "./dist/cli.js"
  },
  "files": [
    "dist",
    "tooling/prepare-validation-runtime.mjs"
  ],
  "scripts": {
    "docs:build": "node tooling/build-docs.mjs",
    "docs:check": "node tooling/build-docs.mjs --check",
    "release:build": "node tooling/build-release.mjs",
    "release:sign": "node tooling/sign-release-cli.mjs",
    "release:refresh": "node tooling/refresh-release-cli.mjs",
    "prepack": "pnpm run build",
    "dev": "node tooling/development.mjs status",
    "dev:local": "node dev/local/cli.mjs",
    "dev:apis": "node dev/real-apis/cli.mjs",
    "dev:polyglot": "node dev/polyglot/run.mjs",
    "dev:model-evaluation": "node dev/model-evaluation/run.mjs",
    "dev:model-codex": "node dev/model-evaluation/codex.mjs",
    "dev:model-review": "node dev/model-evaluation/review.mjs",
    "dev:check": "node tooling/development.mjs check",
    "engine:setup": "node tooling/setup-oasdiff.mjs",
    "runtime:prepare": "node tooling/prepare-validation-runtime.mjs",
    "build": "node tooling/clean-build.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test --test-concurrency=4 test/*.test.mjs",
    "test:package": "node tooling/check-package.mjs",
    "test:isolated": "pnpm build && node --test --test-concurrency=1 integration/*.test.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm test:model-lab && pnpm test:package",
    "test:model-lab": "node --test dev/model-evaluation/classification.test.mjs dev/model-evaluation/semantic-review.test.mjs",
    "self-managed-api": "node ./dist/cli.js"
  },
  "devDependencies": {
    "@notionhq/client": "5.27.0",
    "@types/node": "24.19.1",
    "@types/retry": "0.12.5",
    "notion-v4": "npm:@notionhq/client@4.0.2",
    "postject": "1.0.0-alpha.6",
    "typescript": "7.0.2",
    "@playwright/test": "1.63.0"
  },
  "dependencies": {
    "@babel/parser": "8.0.6",
    "tuf-js": "5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Altitud-Studio-S-L-U/self-managed-api.git"
  },
  "homepage": "https://github.com/Altitud-Studio-S-L-U/self-managed-api#readme",
  "bugs": {
    "url": "https://github.com/Altitud-Studio-S-L-U/self-managed-api/issues"
  }
}
